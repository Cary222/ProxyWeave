{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProxyWeave",
  "version": "0.1.0",
  "identifier": "com.proxyweave.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main", "title": "ProxyWeave", "width": 1180, "height": 760,
        "minWidth": 960, "minHeight": 640, "decorations": false,
        "transparent": true, "shadow": true, "visible": false
      },
      {
        "label": "menubar", "url": "index.html#menubar", "title": "ProxyWeave",
        "width": 360, "height": 500, "decorations": false, "transparent": true,
        "shadow": true, "alwaysOnTop": true, "skipTaskbar": true,
        "resizable": false, "visible": false, "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: tauri:; img-src 'self' data: asset: tauri:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
